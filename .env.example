# Your live site address (used for SEO tags and the sitemap)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: shown in the footer
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Contact form email (Resend: https://resend.com) ----
RESEND_API_KEY=
# Where enquiries are sent (comma-separate for several addresses)
CONTACT_TO_EMAIL=
# Sender. Keep the default until you verify your own domain in Resend,
# then use something like: 10sec <hello@yourdomain.com>
CONTACT_FROM_EMAIL=10sec website <onboarding@resend.dev>

# ---- Blog (Supabase: https://supabase.com) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
